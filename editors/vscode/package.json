{
  "name": "marex-lang",
  "displayName": "Marex Language",
  "description": "Syntax highlighting, file icons, snippets, a formatter and run commands for the Marex language (.mx)",
  "version": "0.2.0",
  "publisher": "oalispahic",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oalispahic/Marex.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Snippets"
  ],
  "keywords": [
    "marex",
    "mx",
    "interpreter"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:marex",
    "onCommand:marex.runFile",
    "onCommand:marex.openRepl"
  ],
  "contributes": {
    "languages": [
      {
        "id": "marex",
        "aliases": [
          "Marex",
          "marex"
        ],
        "extensions": [
          ".mx"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/mx-light.svg",
          "dark": "./icons/mx-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "marex",
        "scopeName": "source.marex",
        "path": "./syntaxes/marex.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "marex",
        "path": "./snippets/marex.json"
      }
    ],
    "configuration": {
      "title": "Marex",
      "properties": {
        "marex.format.collapseBlankLines": {
          "type": "boolean",
          "default": true,
          "description": "Collapse runs of blank lines into a single blank line when formatting."
        },
        "marex.executablePath": {
          "type": "string",
          "default": "marex",
          "description": "Path to the marex executable. Defaults to \"marex\" on PATH."
        },
        "marex.run.saveBeforeRun": {
          "type": "boolean",
          "default": true,
          "description": "Save the file before running it."
        },
        "marex.run.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments passed to the script (available as ARGC and ARGV0, ARGV1, ...)."
        }
      }
    },
    "commands": [
      {
        "command": "marex.runFile",
        "title": "Run File",
        "category": "Marex",
        "icon": "$(play)"
      },
      {
        "command": "marex.openRepl",
        "title": "Open REPL",
        "category": "Marex",
        "icon": "$(terminal)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "marex.runFile",
          "when": "resourceLangId == marex",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "marex.runFile",
          "when": "resourceLangId == marex",
          "group": "marex@1"
        }
      ],
      "explorer/context": [
        {
          "command": "marex.runFile",
          "when": "resourceExtname == .mx",
          "group": "marex@1"
        }
      ],
      "commandPalette": [
        {
          "command": "marex.runFile",
          "when": "resourceLangId == marex"
        }
      ]
    },
    "keybindings": [
      {
        "command": "marex.runFile",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorLangId == marex"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/",
    "package": "npx @vscode/vsce package"
  },
  "icon": "icons/marex.png"
}
