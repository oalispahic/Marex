{
  "if": {
    "prefix": "if",
    "body": ["if (${1:condition})", "\t$0", "fi"],
    "description": "if block"
  },
  "if else": {
    "prefix": "ifelse",
    "body": ["if (${1:condition})", "\t$2", "else", "\t$0", "fi"],
    "description": "if / else block"
  },
  "loop (C-style)": {
    "prefix": "loop",
    "body": ["loop (var ${1:i} := ${2:0}; $1 < ${3:10}; $1++)", "\t$0", "done"],
    "description": "C-style loop"
  },
  "loop (range)": {
    "prefix": "range",
    "body": ["loop ${1:0} -> ${2:10}", "\t$0", "done"],
    "description": "range loop"
  },
  "loop (range with step)": {
    "prefix": "rangestep",
    "body": ["loop ${1:10} -> ${2:0} step ${3:-1}", "\t$0", "done"],
    "description": "range loop with step"
  },
  "function": {
    "prefix": "fun",
    "body": ["fun ${1:name}(${2:params})", "\t$0", "ret ${3:value}"],
    "description": "function returning a value"
  },
  "void function": {
    "prefix": "funv",
    "body": ["fun ${1:name}(${2:params})", "\t$0", "ret"],
    "description": "function without a return value"
  },
  "print line": {
    "prefix": "println",
    "body": ["print(${1:value})", "print(newln)"],
    "description": "print a value followed by a newline"
  }
}
